# Generated files by hugo
/public/
/resources/_gen/
/assets/jsconfig.json
hugo_stats.json

# Executable may be added to repository
hugo.exe
hugo.darwin
hugo.linux

# Temporary lock file while building
/.hugo_build.lock

# Pinned tool binaries downloaded by scripts/setup-dev-env.ps1
/.tools/

# Python bytecode caches and local tooling environment
__pycache__/
/.venv/

# Optional local npm installation artifacts
/node_modules/

# Local history recovery bundles and patches created before Workbench rebases
/.workbench-backups/